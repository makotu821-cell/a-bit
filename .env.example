# Supabase（必須）: Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Drive Picker（任意）: 未設定なら「Googleドライブから選択」ボタンは案内表示のみ
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Googleドライブ自動連携（任意）: バンド共有フォルダのID
# フォルダURL https://drive.google.com/drive/folders/XXXXXXXX の XXXXXXXX 部分
VITE_GOOGLE_DRIVE_FOLDER_ID=
